# Server
PORT=3000
APP_URL=https://your-domain.com

# Aryeo
ARYEO_API_KEY=your_aryeo_api_key
ARYEO_WEBHOOK_SECRET=your_aryeo_webhook_secret

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Slack channels
SLACK_JOBS_CHANNEL=#jobs
SLACK_QC_CHANNEL=#qc-review
SLACK_REPORTS_CHANNEL=#daily-reports

# Assignment strategy: round-robin | least-busy
ASSIGNMENT_STRATEGY=round-robin

# Database
DB_PATH=./data/realtourpilot.db
